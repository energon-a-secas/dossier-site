          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/index.js"
                },
                "region": {
                  "startLine": 42
                }
              }
            }
          ]
        },
        {
          "ruleId": "no-console",
          "level": "warning",
          "message": {
            "text": "Unexpected console statement"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "src/debug.js"
                },
                "region": {
                  "startLine": 15
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
