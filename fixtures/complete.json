            "startLine": 18,
            "highlight": [
              2
            ],
            "source": "export async function take(key: string, cost = 1) {\n  // One round trip, and the script is atomic, so two workers\n  // cannot both read the same remaining budget.\n  return redis.eval(TAKE_SCRIPT, 1, key, String(cost));\n}"
