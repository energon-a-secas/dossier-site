            "path": "src/limiter/bucket.ts",
            "language": "ts",
            "patch": "@@ -10,9 +10,9 @@ export async function allow(key: string) {\n-  const count = local.get(key) ?? 0;\n-  if (count >= limit) return false;\n-  local.set(key, count + 1);\n+  const count = await shared.take(key, 1);\n+  if (count > limit) return false;\n   return true;\n }",
