      {
        "title": "Decisions",
        "summary": "Trade-offs and risks",
        "blocks": [
          {
            "type": "heading",
            "text": "Why this approach",
            "level": 2
          },
          {
            "type": "decision",
            "title": "Shared counter over Redis",
            "context": "The limiter needs one view of the count across all processes.",
            "decision": "Use a local distributed consensus store, not a remote Redis.",
            "consequences": "Lower latency and no external dependency on Redis. The trade-off is that a cascading failure of all store replicas is now possible, versus a single Redis failure affecting only one endpoint."
          },
          {
            "type": "callout",
            "tone": "warn",
            "text": "The fix is deployed to staging only. Production still runs the per-process counter."
          },
          {
            "type": "risks",
            "title": "What could still go wrong",
            "items": [
              {
                "title": "Store unavailability causes all requests to error",
                "severity": "high",
                "likelihood": "unlikely",
                "mitigation": "A local cache with a 60-second TTL serves stale counts when the store is down, so requests do not error."
              },
              {
                "title": "Rebalancing during a spike creates a gap",
                "severity": "medium",
                "likelihood": "possible",
                "mitigation": "The rebalancing waits for in-flight requests to drain, up to a 30-second timeout."
              }
            ]
          },
          {
            "type": "scorecard",
            "title": "Acceptance criteria",
            "criteria": [
