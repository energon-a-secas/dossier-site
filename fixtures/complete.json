      {
        "title": "What changed",
        "summary": "Code and files touched",
        "blocks": [
          {
            "type": "heading",
            "text": "The problem",
            "level": 2
          },
          {
            "type": "prose",
            "text": "The rate limiter counted requests per process, so four workers allowed four times the configured ceiling. The fix shares one counter across all workers using a distributed store.",
            "evidence": [
              {
                "label": "Ticket",
                "href": "https://example.invalid/tickets/2847",
                "kind": "ticket",
                "checkedBy": "human"
              }
            ]
          },
          {
            "type": "compare",
            "title": "How the limit is now counted",
            "kind": "code",
            "language": "ts",
            "left": {
              "label": "Before",
              "value": "const count = local.get(key) ?? 0;\nif (count >= limit) return 429;"
            },
            "right": {
              "label": "After",
              "value": "const count = await shared.get(key) ?? 0;\nif (count >= limit) return 429;"
            }
          },
          {
            "type": "files",
